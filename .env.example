# Copy this file to .env and replace deployment-specific values.
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=open_source_assist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT / OTP — Never commit real secrets.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
OTP_EXPIRE_MINUTES=5

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# SMTP provider settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_START_TLS=true
SMTP_USE_TLS=false

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION_NAME=open_source_repositories
QDRANT_VECTOR_SIZE=384
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
DEFAULT_POPULARITY_WEIGHT=0.3
CANDIDATE_SEARCH_LIMIT=100
DEFAULT_PAGE_LIMIT=20

# Gemini LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# GitHub API
GITHUB_TOKEN=
GITHUB_MIN_REQUEST_INTERVAL=1.0
GITHUB_MAX_RETRIES=3

# Airflow REST API
AIRFLOW_API_URL=http://localhost:8080
AIRFLOW_API_USERNAME=
AIRFLOW_API_PASSWORD=
AIRFLOW_DAG_ID=github_sync_weekly
