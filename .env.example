# ==============================================================================
# Open Source Assist - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment:
#   cp .env.example .env
# ==============================================================================

# Application Environment (development | testing | production)
ENVIRONMENT=development

# API Route Prefix
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Qdrant Vector Database Server Configuration (Server Only)
# ------------------------------------------------------------------------------
# Option 1: Local Qdrant Server (Docker or Native Binary)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Option 2: Qdrant Cloud (Managed production cluster)
# QDRANT_URL=https://<your-cluster-id>.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-secret-qdrant-cloud-api-key

# Use gRPC for high-throughput serialization (Optional: true | false)
QDRANT_PREFER_GRPC=false

# Collection identifier for open-source repositories
QDRANT_COLLECTION_NAME=open_source_repositories

# Dense vector dimensionality matching the embedding model (384 for bge-small)
QDRANT_VECTOR_SIZE=384

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# ------------------------------------------------------------------------------
# Local ONNX model name handled via FastEmbed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# Search & Popularity Ranking Hyperparameters
# ------------------------------------------------------------------------------
# Default weight alpha given to popularity [0.0 = pure semantic, 1.0 = heavy popularity boost]
DEFAULT_POPULARITY_WEIGHT=0.3

# Semantic candidate retrieval count from Qdrant prior to reranking
CANDIDATE_SEARCH_LIMIT=100

# Default pagination page size
DEFAULT_PAGE_LIMIT=20
